#!/bin/sh
# Rueckfall ohne fest verdrahteten Pfad.
#
# Ein fest verdrahteter Systempfad ist aus zwei Gruenden falsch: LoxBerry laesst
# sich anderswohin installieren, und der Pluginpruefer beanstandet die
# Zeichenkette. Eine feste Anzahl von ".." waere nur die naechste Wette -
# je nachdem, wohin LoxBerry diese Datei bei der Installation legt, sind es
# drei oder vier Ebenen. Deshalb wird aufwaerts gesucht, bis ein
# Verzeichnis gefunden ist, das nachweislich eine LoxBerry-Wurzel ist:
# es traegt config/plugins, data/plugins UND config/system/general.json.
# Die dritte Bedingung seit 1.3.14 (Regeln/06, Raumklima-Vorfall): ohne sie
# hielt die Suche einen fremden Baum fuer die Wurzel und loeschte dort die
# Marke und die Zweitschrift (in WSL gemessen, Pruefung-Heimkino-1.3.14,
# Fall U6; Muster 1 der Nachlese).
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
# Heimkino - Deinstallation
#
# Systempakete bleiben stehen: python3-cryptography und python3-requests
# werden von anderen Dingen mitbenutzt, ein blindes Entfernen waere
# schaedlich.
BASE="${5:-${LBHOMEDIR:-}}"
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    BASE=$(lb_wurzel_suchen) || BASE=""
fi
# Ohne brauchbare Wurzel wird gewarnt statt vollzogen: jeder Pfad unten
# begaenne sonst an der Laufwerkswurzel (Regeln/06).
if [ -z "$BASE" ]; then
    echo "<WARNING> Keine LoxBerry-Wurzel gefunden (weder Argument 5 noch \$LBHOMEDIR,"
    echo "<WARNING> und oberhalb dieses Skripts traegt kein Verzeichnis config/plugins,"
    echo "<WARNING> data/plugins und config/system/general.json). Es wurde nichts"
    echo "<WARNING> beendet und nichts geloescht."
    exit 0
fi
PDIR="${3:-heimkino}"
PDATA="$BASE/data/plugins/$PDIR"
PIDDATEI="$PDATA/hk_service.pid"
# Bis 1.2.11 lag die PID-Datei unter log/plugins. Der alte Ort wird
# mitgelesen, damit auch ein Dienst dieser Fassung sauber beendet wird.
PIDDATEI_ALT="$BASE/log/plugins/$PDIR/hk_service.pid"

# Den Sollmerker zuerst entfernen: solange er liegt, startet der minuetliche
# Waechter den Dienst binnen einer Minute wieder - auch mitten in der
# Deinstallation.
rm -f "$PDATA/soll_laufen" 2>/dev/null

# Beendet wird ARGUMENTWEISE ueber /proc, NICHT ueber pkill -f und nicht
# allein ueber die PID-Datei.
#
# Zwei Fehler waeren moeglich, beide teuer:
#
#   pkill -f "hk_service.py" traefe jeden Prozess, in dessen Kommandozeile
#   die Zeichenkette vorkommt - auch einen Editor mit der geoeffneten Datei
#   oder ein tail auf einen Pfad mit diesem Namen. pkill schickt das Signal
#   an ALLE Treffer.
#
#   Die PID-Datei allein reicht aber nicht. purge_installation loescht
#   data/plugins/<ordner>/ bedingungslos (plugininstall.pl :886 -> :1629
#   ff.), und ein Dienst aus der Zeit davor haelt seine Dateisperre danach
#   auf einem geloeschten Inode: die PID-Datei ist weg, der Prozess laeuft.
#   Bis 1.3.12 ueberlebte er die Deinstallation und sprach danach weiter
#   mit dem Beamer und mit MQTT. In WSL gemessen (18.09.2026,
#   Pruefung-Heimkino-1.3.13, Fall U1): 1 Prozess nach dem uninstall.
#   Dieselbe Bauart schliesst postupgrade.sh seit 1.3.12.
#
# Ein Treffer hat GENAU zwei Argumente - einen python-Interpreter und
# zeichengenau den eigenen Dienstpfad - und gehoert dem Dienstbenutzer. Ein
# Editor auf der Datei, ein "tail" auf einen Pfad mit diesem Namen und der
# Einmallauf "hk_service.py --themen" aus dem Reiter Test treffen damit
# nicht (Fall U4).
HK_SKRIPT="${LBPBIN:-$BASE/bin/plugins}/$PDIR/hk_service.py"
HK_UID=$(id -u loxberry 2>/dev/null)
case "$HK_UID" in ''|*[!0-9]*) HK_UID=$(id -u) ;; esac

hk_dienste_finden() {
    for hk_d in /proc/[0-9]*; do
        grep -qaF "hk_service.py" "$hk_d/cmdline" 2>/dev/null || continue
        [ "$(stat -c %u "$hk_d" 2>/dev/null)" = "$HK_UID" ] || continue
        hk_n=0
        hk_treffer=0
        while IFS= read -r hk_arg; do
            hk_n=$((hk_n + 1))
            if [ "$hk_n" = 1 ]; then
                case "${hk_arg##*/}" in
                    python|python3|python3.*) ;;
                    *) break ;;
                esac
            elif [ "$hk_n" = 2 ]; then
                case "$hk_arg" in
                    /*) hk_voll="$hk_arg" ;;
                    # Bei relativem Start steht in cmdline nur der Name; er
                    # wird gegen das Arbeitsverzeichnis des Prozesses
                    # aufgeloest, nicht gegen das eigene.
                    *)  hk_voll=$(readlink -f "$(readlink -f "$hk_d/cwd" 2>/dev/null)/$hk_arg" 2>/dev/null) ;;
                esac
                [ "$hk_voll" = "$HK_SKRIPT" ] && hk_treffer=1
            fi
        done <<HK_ARGUMENTE
$(tr '\0' '\n' < "$hk_d/cmdline" 2>/dev/null)
HK_ARGUMENTE
        if [ "$hk_treffer" = 1 ] && [ "$hk_n" = 2 ]; then
            echo "${hk_d#/proc/}"
        fi
    done
}

beendet=0
HK_UEBRIG=""
for hk_p in $(hk_dienste_finden); do
    beendet=$((beendet + 1))
    # SIGTERM, nicht SIGKILL: der Dienst meldet beim Beenden noch
    # service/online = 0 per MQTT, damit Loxone den Ausfall sieht.
    kill "$hk_p" 2>/dev/null
done
if [ "$beendet" != 0 ]; then
    hk_i=0
    while [ $hk_i -lt 20 ] && [ -n "$(hk_dienste_finden)" ]; do
        sleep 0.25
        hk_i=$((hk_i + 1))
    done
    # Vor JEDEM Signal wird geprueft, auch vor kill -9: hk_dienste_finden
    # liefert nur noch die eigenen, die wirklich noch laufen.
    for hk_p in $(hk_dienste_finden); do
        kill -9 "$hk_p" 2>/dev/null
    done
    sleep 1
    # Die Wirkung nachsehen, nicht den Rueckgabewert von kill.
    HK_UEBRIG=$(hk_dienste_finden | tr '\n' ' ')
fi

# Die PID-Dateien beider Orte fallen in jedem Fall - auch wenn sie auf
# einen toten Prozess zeigen.
rm -f "$PIDDATEI" "$PIDDATEI_ALT" 2>/dev/null

if [ -n "$HK_UEBRIG" ]; then
    echo "<WARNING> Ein Dienst laesst sich nicht beenden (PID $HK_UEBRIG)."
    echo "<WARNING> Er spricht weiter mit dem Beamer und mit MQTT."
elif [ "$beendet" != 0 ]; then
    echo "<OK> $beendet Dienst(e) beendet."
else
    echo "<INFO> Kein laufender Dienst gefunden."
fi

# ---------------------------------------------------------------------------
# BEHALTENE MQTT-THEMEN ABRAEUMEN (seit 1.3.14)
#
# Entschieden am 18.09.2026 (Regeln/07, Abschnitt 3): der Letzte Wille
# service/online darf retained sein - aber nur, wenn die Deinstallation das
# Thema abraeumt. Bis 1.3.13 stand hier kein MQTT-Aufruf; nach dem Entfernen
# blieben service/online und alle behaltenen Zustaende fuer immer im Broker
# (in WSL gemessen, Pruefung-Heimkino-1.3.14, Faelle U1/U2).
#
# NACH dem Anhalten - sonst schriebe der Dienst gleich wieder hinein; sein
# letztes "online=0" wird hier mit abgeraeumt. Der Dienst loescht direkt am
# Broker (paho) und LIEST NACH; die Meldung sagt, was wirklich geschah, und
# ein Broker, der nicht zu fragen ist (CONNACK ungleich 0, SUBACK 0x80),
# heisst nie "nichts belegt". bin/plugins/<ordner> und die Konfiguration mit
# dem Praefix sind hier noch da: der Installer loescht sie erst nach diesem
# Skript (Regeln/06).
#
# 'timeout -k 5 60': ohne -k schickt timeout nach 60 s nur SIGTERM, und ein
# Programm, das es nicht annimmt, hielte die Deinstallation an (Befund
# Sprachsteuerung 0.11.10, ueber acht Stunden; Vorbild Weissware 0.9.34).
# Gemessen mit einem SIGTERM-festen Platzhalter (Fall U5): nach 65 s ist
# Schluss, und der Abbruch steht als WARNING da. Als loxberry, nicht als
# root; stdin geschlossen, damit nichts auf eine Eingabe wartet.
HK_Q=$(printf '%s' "$HK_SKRIPT" | sed "s/'/'\\\\''/g")
HK_B=$(printf '%s' "$BASE" | sed "s/'/'\\\\''/g")
HK_O=$(printf '%s' "$PDIR" | sed "s/'/'\\\\''/g")
HK_MQ_RC=0
if [ -f "$HK_SKRIPT" ] && command -v python3 >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/sh loxberry -c "env PYTHONDONTWRITEBYTECODE=1 LBHOMEDIR='$HK_B' LBPPLUGINDIR='$HK_O' timeout -k 5 60 python3 '$HK_Q' --mqtt-leeren" \
            < /dev/null 2>&1 || HK_MQ_RC=$?
    else
        env PYTHONDONTWRITEBYTECODE=1 LBHOMEDIR="$BASE" LBPPLUGINDIR="$PDIR" \
            timeout -k 5 60 python3 "$HK_SKRIPT" --mqtt-leeren < /dev/null 2>&1 || HK_MQ_RC=$?
    fi
    case "$HK_MQ_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der behaltenen Themen wurde nach 60 s abgebrochen - unter dem Praefix kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <praefix>/<thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der behaltenen Themen reagierte nach 60 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <praefix>/<thema>" ;;
        *)   echo "<WARNING> MQTT: das Leeren der behaltenen Themen endete unerwartet (Rueckgabe $HK_MQ_RC) - unter dem Praefix kann noch etwas im Broker stehen." ;;
    esac
else
    echo "<INFO> MQTT: $HK_SKRIPT oder python3 fehlt - behaltene Themen wurden nicht geleert. Von Hand: mosquitto_pub -r -n -t <praefix>/<thema>"
fi

# ---------------------------------------------------------------------------
# Die Zweitschriften mit den Geheimnissen entfernen.
#
# Die Deinstallation von LoxBerry entfernt nur das VERZEICHNIS
# config/plugins/<ordner>. preupgrade.sh legt aber zwei Dateien eine Ebene
# DARUEBER ab:
#
#   config/plugins/<ordner>.backup.heimkino.cfg    Keycode, Aktionstoken
#   config/plugins/<ordner>.backup.xbox_auth.json  Anwendungskennung,
#                                                  Clientgeheimnis und die
#                                                  Azure-Refresh-Token
#
# Bis 1.2.11 blieben beide nach der Deinstallation liegen - im Klartext.
# Zweite Folge derselben Nachlaessigkeit: die Selbstheilung in
# postinstall.sh holt sie von sich aus zurueck. Eine "saubere"
# Neuinstallation brachte damit das alte Aktionstoken wieder mit, und der
# Anwender hielt es fuer ein frisches.
#
# Ueberschreiben, dann loeschen. shred, wo es da ist; sonst wenigstens
# leeren, damit der Inhalt nicht als Datei stehen bleibt.
geheim_weg() {
    [ -f "$1" ] || return 0
    if command -v shred >/dev/null 2>&1; then
        shred -u "$1" 2>/dev/null && return 0
    fi
    : > "$1" 2>/dev/null
    rm -f "$1" 2>/dev/null
}

PCONFIG_ELTERN="$BASE/config/plugins"
geheim_weg "$PCONFIG_ELTERN/$PDIR.backup.heimkino.cfg"
geheim_weg "$PCONFIG_ELTERN/$PDIR.backup.xbox_auth.json"
geheim_weg "$PCONFIG_ELTERN/$PDIR/xbox_auth.json"
geheim_weg "$PCONFIG_ELTERN/$PDIR/xbox_code.tmp"

# Die Sicherung aus einem abgebrochenen Update liegt ebenfalls ausserhalb
# dessen, was die Deinstallation raeumt - seit 1.3.15 (I6) auch ihre
# Zwischenstaende .neu (abgebrochenes preupgrade) und .alt (frueherer
# Vorgang, preupgrade.sh I2, oder beiseitegelegt von preinstall.sh). Bis
# 1.3.14 blieben diese mit dem Microsoft-Erneuerungstoken liegen, waehrend
# die Schlusszeile "entfernt" meldete (Befund installer 6).
for hk_s in "$PDATA.upgrade_sicherung" "$PDATA.upgrade_sicherung.neu" "$PDATA.upgrade_sicherung.alt"; do
    geheim_weg "$hk_s/heimkino.cfg"
    geheim_weg "$hk_s/xbox_auth.json"
    rm -rf "${hk_s:?}" 2>/dev/null
done
# Die beiseitegelegten Zweitschriften (preinstall.sh, Entscheidung 1).
geheim_weg "$PCONFIG_ELTERN/$PDIR.backup.heimkino.cfg.alt"
geheim_weg "$PCONFIG_ELTERN/$PDIR.backup.xbox_auth.json.alt"
# Der Merker "Dienst lief vor der Aktualisierung" (I3).
rm -f "$PDATA.lief_vorher" 2>/dev/null

# Dasselbe gilt fuer die Marke "Aktualisierung laeuft", die preupgrade.sh
# neben den Datenordner legt. Bliebe sie liegen, wiese eine anschliessende
# Neuinstallation den Dienststart bis zu einer Stunde lang ab - und im
# Protokoll stuende nur "Eine Aktualisierung dieses Plugins laeuft".
if [ -f "$PDATA.upgrade_laeuft" ]; then
    rm -f "$PDATA.upgrade_laeuft" 2>/dev/null
    if [ -f "$PDATA.upgrade_laeuft" ]; then
        echo "<WARNING> Die Marke $PDATA.upgrade_laeuft liess sich nicht entfernen."
    else
        echo "<OK> Marke der Aktualisierung entfernt."
    fi
fi

# Die Schlusszeile kommt erst nach einer NACHZAEHLUNG (seit 1.3.15, I6):
# alles, was neben den beiden Ordnern mit "<ordner>." beginnt. Die Liste der
# gemerkten MQTT-Praefixe bleibt nur liegen, wenn dort noch behaltene Themen
# stehen koennen (das Leeren oben ist dann gescheitert) - sie nennt sie.
HK_REST=""
for hk_f in "$PCONFIG_ELTERN/$PDIR".* "$BASE/data/plugins/$PDIR".*; do
    [ -e "$hk_f" ] || [ -L "$hk_f" ] || continue
    HK_REST="$HK_REST $hk_f"
done
if [ -n "$HK_REST" ]; then
    echo "<WARNING> Nach der Deinstallation liegt noch:$HK_REST"
    echo "<WARNING> Bitte von Hand entfernen (Zweitschriften enthalten Aktionstoken,"
    echo "<WARNING> Keycode und die Microsoft-Anmeldung)."
else
    echo "<OK> Zweitschriften mit Keycode, Aktionstoken und Microsoft-Anmeldung entfernt (nachgezaehlt: 0 Reste)."
fi
exit 0
