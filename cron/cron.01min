#!/bin/sh
# Heimkino - Waechter, minuetlich.
# Startet den Dienst neu, wenn er laufen soll, aber nicht laeuft.
#
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Ausdruecklich KEINE Rechnung mit "..": LoxBerry legt die Datei
# drei Ebenen unter der Wurzel ab, ein $SELF/../.. landet damit auf
# <Wurzel>/system - und der Waechter suchte dort nach bin/plugins/..., wo
# nichts liegt (am Geraet gemessen, 18.08.2026).
#
# Der Aufruf geht ausdruecklich ueber die Shell: geht bei einem misslungenen
# Update das Ausfuehrungsrecht an dienst.sh verloren, schluege der
# unmittelbare Aufruf lautlos fehl.
#
# Die regulaere Ausgabe bleibt still (sonst schreibt der Cron jede Minute),
# die FEHLERausgabe landet in einer eigenen Datei neben dem Protokoll - ein
# Waechter, der schweigend nichts tut, ist schlimmer als keiner.
#
# Seit 1.3.15 (I5, Bauform Abfahrts-Assistent 1.6.10): erst den Ordner
# anlegen und cron.err anfassen. Fehlt log/plugins/heimkino (Ramdisk), fuehrt
# dash den Befehl gar nicht aus, wenn die Umlenkung scheitert - der Waechter
# arbeitete dann nicht, ohne eine Zeile (gemessen, Befund installer 5). Ein
# Anhaengen ohne Inhalt frischt die Aenderungszeit nicht auf (Regeln/06), und
# die Logwartung raeumt eine alte Datei weg.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 1.3.32 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 1.3.31 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
# Gruppe 9 (1.3.30, Entwurf 3.9): zuerst der Waechter der Befehlsbruecke - er startet sie jede Minute, wenn
# "Befehle ueber MQTT annehmen" gesetzt ist, und haelt sie sonst an (befehlsbruecke.php --waechter: misst
# zustand.json, nie waehrend einer Aktualisierung, hoechstens alle 600 s ein Neustart). Kein Start in den
# Hakenskripten. Er steht VOR dem Dienstwaechter, der die Startsperre nimmt.
/bin/bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"$ERR"
/bin/bash "REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$ERR"
